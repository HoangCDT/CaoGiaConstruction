@model List<CaoGiaConstruction.WebClient.Context.Entities.TeamMember>
@using CaoGiaConstruction.WebClient.Context.Enums

<div class="team-members-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5>Đội ngũ</h5>
        <button type="button" class="btn btn-success btn-add-team-member mb-2">
            <i class="mdi mdi-plus-circle"></i> Thêm mới
        </button>
    </div>
    <div class="table-responsive">
        <table id="table-team-member" class="table table-hover table-centered w-100 dt-responsive nowrap">
            <thead class="table-light">
                <tr>
                    <th class="center" style="width: 30px;"></th>
                    <th class="center">STT</th>
                    <th class="all">Họ tên</th>
                    <th class="all">Chức vụ</th>
                    <th>Avatar</th>
                    <th>Founder</th>
                    <th>Sort Order</th>
                    <th>Trạng thái</th>
                    <th style="width: 85px;">#</th>
                </tr>
            </thead>
            <tbody id="team-member-sortable">
                @if (Model != null && Model.Any())
                {
                    int num = 0;
                    foreach (var item in Model.OrderBy(x => x.SortOrder))
                    {
                        <tr class="team-member-item" data-id="@item.Id">
                            <td class="center middle" width="30">
                                <i class="mdi mdi-drag drag-handle" style="cursor: move;"></i>
                            </td>
                            <td class="center middle" width="20">
                                <strong>#@(++num)</strong>
                            </td>
                            <td>
                                <p class="m-0 d-inline-block align-middle font-13">
                                    <strong>@item.FullName</strong>
                                </p>
                            </td>
                            <td>
                                <p class="m-0 d-inline-block align-middle font-13">
                                    @item.Position
                                </p>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Avatar))
                                {
                                    <img src="~/@item.Avatar" alt="@item.FullName" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                                }
                                else
                                {
                                    <img src="~/Admin/assets/images/no_image.png" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                                }
                            </td>
                            <td>
                                @if (item.IsFounder)
                                {
                                    <span class="badge badge-success-lighten">Founder</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary-lighten">Member</span>
                                }
                            </td>
                            <td>
                                <strong>@item.SortOrder</strong>
                            </td>
                            <td>
                                <div>
                                    <input type="checkbox" id="status-team-@(item.Id)" data-id="@item.Id"
                                           @(item.Status == StatusEnum.Active ? "checked" : "")
                                           class="switch-status" data-switch="success">
                                    <label for="status-team-@(item.Id)" data-on-label="Yes" data-off-label="No"
                                           class="mb-0 d-block"></label>
                                </div>
                            </td>
                            <td class="table-action text-nowrap">
                                <a href="javascript:void(0);" data-id="@item.Id"
                                   class="action-icon btn-edit" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Edit" data-bs-original-title="Edit">
                                    <i class="mdi mdi-square-edit-outline"></i>
                                </a>
                                <a href="javascript:void(0);" data-id="@item.Id"
                                   class="action-icon btn-delete" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Delete" data-bs-original-title="Delete">
                                    <i class="mdi mdi-delete"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9">
                            <div class="alert alert-warning w-50 m-auto text-center" role="alert">
                                Không có dữ liệu trong danh mục này
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_ModalTeamMemberAction")
