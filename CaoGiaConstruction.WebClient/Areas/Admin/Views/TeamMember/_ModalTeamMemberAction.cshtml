<div class="modal fade" id="modal-team-member" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <form id="form-team-member">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="myLargeModalLabel">Thêm / Chỉnh sửa Đội ngũ</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-7">
                            <div class="row">
                                <div class="col-12">
                                    <div class="mb-3"><i>Lưu ý: </i>(<span class="text-danger">*</span>) là trường bắt buộc nhập</div>
                                </div>
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label for="fullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                        <input class="form-control" type="text" name="fullName" placeholder="Vui lòng nhập">
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label for="position" class="form-label">Chức vụ <span class="text-danger">*</span></label>
                                        <input class="form-control" type="text" name="position" placeholder="Ví dụ: CEO & Founder">
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label for="quote" class="form-label">Câu nói (Quote)</label>
                                        <textarea class="form-control" name="quote" rows="3" placeholder="Câu nói hoặc giới thiệu ngắn"></textarea>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="sortOrder" class="form-label">Thứ tự sắp xếp <span class="text-danger">*</span></label>
                                        <input class="form-control" type="number" name="sortOrder" value="0" placeholder="0">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="isFounder" class="form-label">Là Founder</label>
                                        <br />
                                        <div>
                                            <input type="checkbox" id="isFounder" name="isFounder" class="switch-status" data-switch="success">
                                            <label for="isFounder" data-on-label="Yes" data-off-label="No" class="mb-0 d-block"></label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label for="status-team-member" class="form-label">Trạng thái: &nbsp;</label>
                                        <br />
                                        <div>
                                            <input type="checkbox" id="status-team-member" checked name="status"
                                                class="switch-status" data-switch="success">
                                            <label for="status-team-member" data-on-label="Yes" data-off-label="No"
                                                class="mb-0 d-block"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
                            <div class="row">
                                <div class="col-12">
                                    <div class="upload-file-wrap">
                                        <label class="form-label mb-2">Ảnh đại diện</label>
                                        <!-- File Upload -->
                                        <div class="upload-file">
                                            <div class="image-preview-wrap">
                                                <img src="~/Admin/assets/images/no_image.png" class="image-preview" />
                                                <input type="hidden" name="avatar" value="" />
                                            </div>
                                        </div>
                                        <div class="mt-3">
                                            <div class="input-group">
                                                <input name="file" type="file" class="form-control select-file" accept="image/*" />
                                                <button class="btn btn-danger btn-delete-file" type="button">
                                                    <i class="mdi mdi-trash-can"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success ladda-button" id="btn-save-team-member" data-style="expand-right">
                        <i class="mdi mdi-content-save"></i> Lưu lại
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
